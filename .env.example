# PocketSmart AI Environment Configuration

# Gemini AI Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Security & Authentication
SECRET_KEY=pocketsmart_production_secret_key_random_string_2026_xyz
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (SQLite default, can be swapped for PostgreSQL e.g. postgresql://user:pass@localhost/pocketsmart)
DATABASE_URL=sqlite:///./pocketsmart.db

# App Settings
APP_NAME="PocketSmart AI"
APP_ENV=development
DEBUG=True
HOST=127.0.0.1
PORT=8000
MAX_UPLOAD_SIZE_MB=5
